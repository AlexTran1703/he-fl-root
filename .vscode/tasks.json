{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "[BUILD] Configure CMake (Debug Mode)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "group": "build",
            "problemMatcher": [],
            "detail": "Configure CMake project"
        },
        {
            "label": "[BUILD] Build CMake (Debug Mode)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build",
                "--config",
                "Debug"
            ],
            "group": "build",
            "dependsOn": "[BUILD] Configure CMake (Debug Mode)",
            "problemMatcher": [],
            "detail": "Build the CMake project debug"
        },
        {
            "label": "[CLEAN] Clean All CMake Build",
            "type": "shell",
            "command": "./scripts/clear_script.sh all",
            "args": [],
            "group": "clear",
            "problemMatcher": [],
            "detail": "[CLEAN] Clean All CMake Build"
        },
